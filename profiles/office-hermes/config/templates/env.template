# ═══════════════════════════════════════════════════════════════════════════════
# HERMES ENVIRONMENT VARIABLES (.env) TEMPLATE
# ═══════════════════════════════════════════════════════════════════════════════
#
# LOCATION: ~/.hermes/.env
# USAGE: copy this file to ~/.hermes/.env and fill in actual values
#
# SECURITY:
#   ⚠ This file contains secrets (API keys, tokens, credentials)
#   ⚠ Never commit to version control
#   ⚠ Never share with anyone
#   ⚠ Restrict permissions: chmod 600 ~/.hermes/.env
#   ⚠ Use strong secrets (random, long, unique per service)
#
# SOURCING:
#   Hermes automatically loads ~/.hermes/.env on startup via python-dotenv
#   Values can be accessed in config.yaml via ${VAR_NAME} syntax
#   Example: mcp_servers.zoho_crm.env.ZOHO_CRM_ACCESS_TOKEN: ${ZOHO_CRM_ACCESS_TOKEN}
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 1. LLM PROVIDER CREDENTIALS
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API (Claude models)
# Get key: https://console.anthropic.com/account/keys
# Usage: Used by default if provider: anthropic in config.yaml
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API (GPT models)
# Get key: https://platform.openai.com/account/api-keys
# Required if using fallback_model.provider: openai
OPENAI_API_KEY=sk-proj-...

# OpenRouter proxy (routes to any model)
# Get key: https://openrouter.ai/keys
# Required for multi-model failover strategy
OPENROUTER_API_KEY=sk-or-...

# AWS Bedrock (if using bedrock provider)
# Configured via AWS CLI / IAM credentials (~/.aws/credentials)
# Not needed in .env if using instance roles / assumed roles
AWS_PROFILE=default
AWS_REGION=us-east-1

# Google Gemini (if using fallback)
GEMINI_API_KEY=AIza...

# Ollama (local open-weights models)
# If provider: ollama, Hermes connects to http://localhost:11434
# No API key needed for local deployment
OLLAMA_BASE_URL=http://localhost:11434

# Nous Portal (if using nous provider)
# OAuth flow — usually handled via browser, not env var
# Leave empty; Hermes will handle auth flow


# ─────────────────────────────────────────────────────────────────────────────
# 2. PLATFORM INTEGRATIONS (Messaging, Calendar, Email)
# ─────────────────────────────────────────────────────────────────────────────

# Telegram Bot Tokens (one per bot home)
# Get from: https://t.me/BotFather
# Format: Bot{token}
HERMES_CMO_TELEGRAM_TOKEN=877058...
HERMES_MANAGER_TELEGRAM_TOKEN=887996...
HERMES_EMPLOYEE_TELEGRAM_TOKEN=874965...

# Discord Bot Token (if using discord platform)
# Get from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_token_here

# Slack Bot Token (if using slack platform)
# Get from: https://api.slack.com/apps/{APP_ID}/oauth-tokens
SLACK_BOT_TOKEN=xoxb-...

# Google Workspace (Gmail, Calendar, Drive, Sheets)
# OAuth 2.0 credentials; Hermes handles auth flow via browser
# Client ID/Secret from: https://console.developers.google.com
# Tokens stored locally in ~/.hermes/google_token.json
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# Microsoft Teams
TEAMS_BOT_ID=your_bot_id
TEAMS_BOT_PASSWORD=your_bot_password


# ─────────────────────────────────────────────────────────────────────────────
# 3. MCP SERVER CREDENTIALS
# ─────────────────────────────────────────────────────────────────────────────
# Model Context Protocol servers expose external tools/data sources.
# Each server has its own auth scheme (OAuth, API key, etc.).

# n8n Workflow Automation
# Get key: https://docs.n8n.io/reference/cli-commands/list-credentials/
N8N_API_KEY=eyJhbG...

# Zoho CRM (customer relationship management)
# Get token: https://www.zoho.com/crm/developer/docs/oauth.html
# Token format: 1000.{access_token}
ZOHO_CRM_ACCESS_TOKEN=1000.LTDOQG7N36WME0ZZAF41MK7D2MHYDB
ZOHO_CRM_REFRESH_TOKEN=1000.{refresh_token}

# HuggingFace Hub (model search, dataset access)
# Get token: https://huggingface.co/settings/tokens
# Handled via OAuth in config; include token if offline access needed
HUGGINGFACE_TOKEN=hf_...

# Supabase (PostgreSQL + realtime DB)
# Get key: https://supabase.com/dashboard/project/{PROJECT_ID}/settings/api
SUPABASE_URL=https://...supabase.co
SUPABASE_KEY=eyJhbG...

# Calendly (scheduling/meeting booking)
# OAuth handled by MCP; no manual token needed usually

# Figma (design tool)
# Get token: https://www.figma.com/developers/api
# Personal access tokens are NOT recommended; use OAuth instead
FIGMA_AUTH_TOKEN=figd_...

# Notion (database and document tool)
# Get integration token: https://www.notion.so/my-integrations
NOTION_AUTH_TOKEN=secret_...

# Canva (design platform)
# OAuth handled; no manual token needed

# Postman (API testing)
# OAuth handled; no manual token needed

# Vercel (deployment platform)
# Get token: https://vercel.com/account/tokens
VERCEL_TOKEN=...

# Railway (deployment platform)
# Get token: https://railway.app/project/{PROJECT}/settings/tokens
RAILWAY_API_TOKEN=...


# ─────────────────────────────────────────────────────────────────────────────
# 4. EXTERNAL SERVICES & TOOLS
# ─────────────────────────────────────────────────────────────────────────────

# Firecrawl (web scraping + LLM extraction)
# Get key: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=fc_...

# Honcho (memory backend provider)
# Self-hosted or cloud — depends on deployment
HONCHO_API_KEY=hch_...
HONCHO_BASE_URL=https://api.honcho.dev

# Anthropic Token (for browser-based auth flows)
# Used when redirecting to Anthropic login page
ANTHROPIC_TOKEN=...

# Spotify (music control, playlist access)
# Get credentials: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=...
SPOTIFY_CLIENT_SECRET=...

# Twitter/X API (search, posting)
# Get credentials: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=...
TWITTER_API_SECRET=...
TWITTER_BEARER_TOKEN=...

# GitHub (repo access, CLI integration)
# Get token: https://github.com/settings/tokens
# Required for gh CLI integration
GITHUB_TOKEN=ghp_...

# ─────────────────────────────────────────────────────────────────────────────
# 5. INFRASTRUCTURE & DEPLOYMENT
# ─────────────────────────────────────────────────────────────────────────────

# Docker credentials (if using private registries)
DOCKER_REGISTRY_URL=docker.io
DOCKER_USERNAME=your_username
DOCKER_PASSWORD=your_password

# Kubernetes (if deploying via K8s)
KUBECONFIG=/path/to/kubeconfig.yaml

# Sentry (error tracking / observability)
# Get key: https://sentry.io/settings/account/
SENTRY_DSN=https://...@sentry.io/...

# DataDog (monitoring & observability)
DATADOG_API_KEY=...
DATADOG_APP_KEY=...

# ─────────────────────────────────────────────────────────────────────────────
# 6. SECURITY & COMPLIANCE
# ─────────────────────────────────────────────────────────────────────────────

# Audit log destination (if remote)
# Format: { service: "s3" | "gcs" | "syslog", ...config }
# Default: local SQLite (no env var needed)
AUDIT_LOG_SERVICE=s3
AUDIT_LOG_S3_BUCKET=company-audit-logs
AUDIT_LOG_S3_PREFIX=hermes/

# TLS certificates (for secure agent-to-agent communication)
TLS_CERT_PATH=/etc/hermes/certs/server.crt
TLS_KEY_PATH=/etc/hermes/certs/server.key

# Secrets encryption key (for at-rest encryption)
# Base64-encoded 32-byte key for AES-256-GCM
SECRETS_ENCRYPTION_KEY=...

# ─────────────────────────────────────────────────────────────────────────────
# 7. DEVELOPMENT / DEBUGGING
# ─────────────────────────────────────────────────────────────────────────────

# Enable debug logging (very verbose, only for development)
DEBUG=0                           # 0=off, 1=on
LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR

# Print all tool calls and responses (security risk!)
DEBUG_TOOL_CALLS=0                # 0=off, 1=on

# Run in "dry-run" mode (no actual actions, only simulate)
DRY_RUN=0

# Override LLM provider for testing (force specific backend)
# OVERRIDE_PROVIDER=openai
# OVERRIDE_MODEL=gpt-4

# ─────────────────────────────────────────────────────────────────────────────
# 8. PROXY & NETWORK
# ─────────────────────────────────────────────────────────────────────────────

# HTTP proxy (if behind corporate firewall)
HTTP_PROXY=http://proxy.company.com:8080
HTTPS_PROXY=http://proxy.company.com:8080
NO_PROXY=localhost,127.0.0.1,.company.com

# ─────────────────────────────────────────────────────────────────────────────
# 9. PERFORMANCE TUNING
# ─────────────────────────────────────────────────────────────────────────────

# Max concurrent MCP server connections
MCP_MAX_CONNECTIONS=10

# Thread pool size for background jobs
THREAD_POOL_SIZE=4

# Cache directory (for prompt cache, model downloads, etc.)
CACHE_DIR=~/.hermes/cache

# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY CHECKLIST
# ═══════════════════════════════════════════════════════════════════════════════
#
# Before deploying, verify:
#
# □ All secrets are filled in (no "..." placeholders)
# □ No secrets are committed to version control (check .gitignore)
# □ File permissions are restrictive: chmod 600 ~/.hermes/.env
# □ Secrets are rotated periodically (quarterly recommended)
# □ API keys have minimal permissions (principle of least privilege)
# □ Audit logging is enabled (AUDIT_LOG_SERVICE set)
# □ TLS certificates are valid (if using secure communication)
# □ Secrets are never logged (check LOG_LEVEL=INFO or higher)
# □ Each bot home has separate credentials (don't share tokens)
#
# ROTATING SECRETS:
#
#   1. Generate new secret/token from service
#   2. Update .env with new value
#   3. Test with hermes --test-credentials
#   4. Monitor for errors (old credential might be cached)
#   5. Invalidate old credential in service dashboard
#   6. Wait 24h for caches to clear
#
# ═══════════════════════════════════════════════════════════════════════════════
